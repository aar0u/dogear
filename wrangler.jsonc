{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dogear",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "vars": {
    "WASMTTS_RELEASE": "https://github.com/aar0u/dogear/releases/download/voice-pack/"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/books/*"]
  },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): READER_KEY, DAV_URL, DAV_USER, DAV_PASS.
  // Local dev reads them from .dev.vars.
}
